{
	"name": "dataflowtransrom",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_dl_extsrc",
						"type": "DatasetReference"
					},
					"name": "sourceDL"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "pivot"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CustID as string,",
				"          Product as string,",
				"          Sales as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> sourceDL",
				"sourceDL pivot(groupBy(CustID),",
				"     pivotBy(Product),",
				"     TotalSales = sum(toInteger(Sales)),",
				"     columnNaming: '$N$V',",
				"     lateral: true) ~> pivot",
				"pivot sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}