{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "b6-adf-studio"
		},
		"LS_AWS_S3_secretAccessKey": {
			"type": "secureString",
			"metadata": "Secure string for 'secretAccessKey' of 'LS_AWS_S3'"
		},
		"LS_AzSQLDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzSQLDB'"
		},
		"LS_DL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DL'"
		},
		"LS_AWS_S3_properties_typeProperties_accessKeyId": {
			"type": "string",
			"defaultValue": "AKIA36I7PG4KA777BHLI"
		},
		"LS_AzSQLDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldatabaseserverjuly.database.windows.net"
		},
		"LS_AzSQLDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azureSQLDB-CI"
		},
		"LS_AzSQLDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adeazuresql"
		},
		"LS_DL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://b6datalakestorageaccount.dfs.core.windows.net/"
		},
		"LS_Github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"LS_KEyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://AKVMysqlCred.vault.azure.net/"
		},
		"LS_OnPremiseMYSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "127.0.0.1"
		},
		"LS_OnPremiseMYSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "b6_mysqldb"
		},
		"LS_OnPremiseMYSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "b6-adf-studio_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AWS_S3_secretAccessKey": {
						"value": "[parameters('LS_AWS_S3_secretAccessKey')]"
					},
					"LS_AzSQLDB_password": {
						"value": "[parameters('LS_AzSQLDB_password')]"
					},
					"LS_DL_accountKey": {
						"value": "[parameters('LS_DL_accountKey')]"
					},
					"LS_AWS_S3_properties_typeProperties_accessKeyId": {
						"value": "[parameters('LS_AWS_S3_properties_typeProperties_accessKeyId')]"
					},
					"LS_AzSQLDB_properties_typeProperties_server": {
						"value": "[parameters('LS_AzSQLDB_properties_typeProperties_server')]"
					},
					"LS_AzSQLDB_properties_typeProperties_database": {
						"value": "[parameters('LS_AzSQLDB_properties_typeProperties_database')]"
					},
					"LS_AzSQLDB_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzSQLDB_properties_typeProperties_userName')]"
					},
					"LS_DL_properties_typeProperties_url": {
						"value": "[parameters('LS_DL_properties_typeProperties_url')]"
					},
					"LS_Github_properties_typeProperties_url": {
						"value": "[parameters('LS_Github_properties_typeProperties_url')]"
					},
					"LS_KEyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KEyvault_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "b6-adf-studio_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_OnPremiseMYSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_OnPremiseMYSQL_properties_typeProperties_server')]"
					},
					"LS_OnPremiseMYSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_OnPremiseMYSQL_properties_typeProperties_database')]"
					},
					"LS_OnPremiseMYSQL_properties_typeProperties_username": {
						"value": "[parameters('LS_OnPremiseMYSQL_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'b6-adf-studio_ArmTemplate_0')]"
			]
		},
		{
			"name": "b6-adf-studio_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'b6-adf-studio_ArmTemplate_1')]"
			]
		}
	]
}